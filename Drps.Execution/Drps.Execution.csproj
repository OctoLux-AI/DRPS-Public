<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Drps.Execution-f640e4dc-8aaa-485a-ba28-72913826b6f8</UserSecretsId>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drps.Shared\Drps.Shared.csproj" />
    <ProjectReference Include="..\Drps.Ingestion\Drps.Ingestion.csproj" />
    <!-- FillConfirmationService calls LedgerPositionWriter directly - the shared, audited
         Position write path (CLAUDE.md's Execution Layer: Fourth Design Decision). -->
    <ProjectReference Include="..\Drps.Ledger\Drps.Ledger.csproj" />
    <!-- OrderFiringService.FireAsync calls SentimentMultiplierService directly (Sentiment
         Adjuster Multiplier Decision, CLAUDE.md 2026-07-24). No circular reference - Drps.Adjuster
         does not reference Drps.Execution. -->
    <ProjectReference Include="..\Drps.Adjuster\Drps.Adjuster.csproj" />
  </ItemGroup>

  <!-- Drps.Ingestion's and Drps.Adjuster's own appsettings.json/appsettings.Development.json
       flow transitively into this project's publish output via the ProjectReferences above
       (standard MSBuild content propagation), colliding with this project's own same-named files
       (NETSDK1152) - same conflict Drps.Calculator/Drps.Gate already hit and fixed. Only this
       project's own copies should ever land in its own publish output - strip anything with a
       matching filename whose source isn't this project's own directory. Publish-output
       plumbing only; does not touch which appsettings.json this project loads at runtime. -->
  <Target Name="ExcludeReferencedProjectAppSettingsFromPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="('%(Filename)%(Extension)' == 'appsettings.json' Or '%(Filename)%(Extension)' == 'appsettings.Development.json') And !$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>
</Project>
