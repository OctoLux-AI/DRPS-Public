<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Split from the original Drps.Tests (2026-08-13) - carries tests for Drps.Execution/
       Adjuster/Monolith. Drps.Execution/Adjuster/Monolith were made self-contained the same day
       (closing the NETSDK1151 failure this project previously hit), so this now builds and runs
       independently, same as Drps.Tests.Core. -->

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drps.Shared\Drps.Shared.csproj" />
    <ProjectReference Include="..\Drps.Ingestion\Drps.Ingestion.csproj" />
    <ProjectReference Include="..\Drps.Ledger\Drps.Ledger.csproj" />
    <ProjectReference Include="..\Drps.Adjuster\Drps.Adjuster.csproj" />
    <ProjectReference Include="..\Drps.Monolith\Drps.Monolith.csproj" />
    <ProjectReference Include="..\Drps.Execution\Drps.Execution.csproj" />
    <!-- AtrRatchetMonitorWorkerTests.cs uses Drps.Gate.Scoring (GateRejectionReason) directly -
         a real dependency missed during the original split (that file lives at this project's
         root, not under an Execution\/Adjuster\ subfolder, so the split's own per-folder
         Calculator/Gate reference check didn't cover it). Found and fixed here. -->
    <ProjectReference Include="..\Drps.Gate\Drps.Gate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
